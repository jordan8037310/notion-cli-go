{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "fullstack-dev-skills@fullstack-dev-skills": true
  },
  "permissions": {
    "deny": [
      "Bash(sudo:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf $HOME*)",
      "Bash(rm -rf /Users/*)",
      "Bash(chmod -R 777 /:*)",
      "Bash(chmod -R 777 ~:*)",
      "Bash(chmod -R 777 /Users/*)",
      "Bash(chown -R:*)",
      "Bash(mkfs:*)",
      "Bash(dd if=*)",
      "Bash(dd of=/dev/*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.ssh/**)",
      "Read(**/.aws/credentials)",
      "Read(**/.aws/config)",
      "Read(**/.gcloud/**)",
      "Read(**/gcloud/application_default_credentials.json)",
      "Read(**/credentials.json)",
      "Read(**/client_secret*.json)",
      "Read(**/.netrc)",
      "Read(**/.npmrc)",
      "Read(**/.yarnrc)",
      "Read(**/.pypirc)",
      "Read(**/.docker/config.json)",
      "Read(**/*private*key*)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/*secret*)",
      "Bash(cat .env)",
      "Bash(cat .env.*)",
      "Bash(cat **/.env)",
      "Bash(cat **/.env.*)",
      "Bash(head .env*)",
      "Bash(tail .env*)",
      "Bash(less .env*)",
      "Bash(more .env*)",
      "Bash(grep *=* .env)",
      "Bash(grep *=* .env.*)",
      "Bash(echo $*_TOKEN*)",
      "Bash(echo $*_SECRET*)",
      "Bash(echo $*_KEY*)",
      "Bash(echo $NOTION_API_KEY*)",
      "Bash(printenv *TOKEN*)",
      "Bash(printenv *SECRET*)",
      "Bash(printenv *KEY*)",
      "Bash(printenv NOTION_API_KEY*)",
      "Bash(env | grep *)",
      "Bash(git push upstream*)",
      "Bash(git push*kris-hansen*)",
      "Bash(git push --force origin main*)",
      "Bash(git push --force-with-lease origin main*)",
      "Bash(git push -f origin main*)",
      "Bash(git push*origin*+main*)",
      "Bash(git push*+refs/heads/main*)",
      "Bash(git push*origin +main*)",
      "Bash(git reset --hard origin/main)",
      "Bash(git reset --hard upstream/main)",
      "Bash(git clean -fdx*)",
      "Bash(git branch -D main*)",
      "Bash(gh pr merge*--base main*)",
      "Bash(gh repo delete*)",
      "Bash(gh repo transfer*)",
      "Bash(gh auth logout*)",
      "Bash(gh secret set*)",
      "Bash(gh secret delete*)",
      "Bash(gh ssh-key delete*)",
      "Bash(gh gpg-key delete*)",
      "Bash(brew uninstall*)",
      "Bash(brew services stop*)",
      "Bash(npm publish*)",
      "Bash(npm unpublish*)",
      "Bash(go clean -modcache*)",
      "Bash(docker system prune*)",
      "Bash(docker volume rm*)",
      "Bash(lando destroy*--all*)",
      "Bash(curl*| bash*)",
      "Bash(curl*| sh*)",
      "Bash(wget*| bash*)",
      "Bash(wget*| sh*)"
    ]
  }
}
